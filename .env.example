# Copy this file to .env and fill in your Supabase project's values.
# Never commit the real .env file - it is gitignored.
#
# Self-hosted (see supabase/selfhost/README.md): SUPABASE_URL is your
# server's gateway address, e.g. http://<tailscale-name>:8000, and
# SUPABASE_ANON_KEY is the ANON_KEY from that stack's own .env.
#
# Supabase Cloud: find these in your project's Settings -> API.
#
# If left as the placeholder values below, the app runs fully local-only
# with no sync - Env.isConfigured is false and Supabase.initialize is
# never called.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
